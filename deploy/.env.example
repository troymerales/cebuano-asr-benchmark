# Copy this file to deploy/local/.env (for local_app.py) and/or
# deploy/prod/.env (for prod_app.py) -- or to deploy/.env to share one
# file between both. Never commit the real .env file(s).

# --- local_app.py only (Kaldi engine) ---
# Same Kaldi checkout train_kaldi.ipynb used.
# KALDI_ROOT=/home/you/kaldi
# Exported model to decode with. Defaults to models/tri3 in the repo.
# BISAYA_KALDI_MODEL_DIR=models/tri3
# Fixed LM weight for decoding (no reference transcript to sweep against here).
# BISAYA_KALDI_LMWT=13
# Scratch dir for per-request Kaldi data/mfcc/decode dirs. Must be a
# WSL-native path (not under /mnt/c/...) -- see deploy/README.md.
# BISAYA_DEPLOY_WORK_DIR=/home/you/bisaya_deploy_work

# --- local_app.py only (ElevenLabs engine) ---
# ELEVENLABS_API_KEY=your-key-here

# --- local_app.py only (SOAP note generation) ---
# Without this, local_app.py shows "SOAP note unavailable" instead of
# calling Gemini. prod_app.py never calls Gemini regardless -- see
# deploy/prod/soap_infer.py.
# GEMINI_API_KEY=your-key-here
# Override to use a different Gemini model.
# BISAYA_SOAP_MODEL_ID=gemini-2.5-flash

# --- both local_app.py and prod_app.py (Whisper engine) ---
# Override to use a different Hub checkpoint or a local export.
# BISAYA_WHISPER_MODEL_ID=troxyz1268/whisper-small-bisaya
